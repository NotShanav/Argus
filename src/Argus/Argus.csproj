<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <StartupObject>PresenceGuard.Program</StartupObject>
    <AssemblyName>Argus</AssemblyName>
    <RootNamespace>PresenceGuard</RootNamespace>
    <ApplicationIcon>Assets\Argus.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- Version info (CI overrides Version from the git tag) -->
    <Version>1.0.0</Version>
    <Product>Argus</Product>
    <AssemblyTitle>Argus</AssemblyTitle>
    <Description>Presence guard that locks Windows when you are not the person at the screen.</Description>
    <Company>Argus</Company>
    <Copyright>Copyright (c) Argus contributors</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20261107" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20261107" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.*" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\argus_tray.png" LogicalName="Argus.tray.png" />
    <!-- Explicit (non-glob) so they are picked up even when downloaded during this build -->
    <None Include="models\face_detection_yunet_2023mar.onnx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="models\face_recognition_sface_2021dec.onnx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Fetch the face models on first build (they are not stored in git) -->
  <Target Name="EnsureFaceModels" BeforeTargets="BeforeBuild"
          Condition="!Exists('$(MSBuildProjectDirectory)\models\face_detection_yunet_2023mar.onnx') Or !Exists('$(MSBuildProjectDirectory)\models\face_recognition_sface_2021dec.onnx')">
    <Message Importance="high" Text="Downloading face models..." />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\scripts\get-models.ps1&quot; -Destination &quot;$(MSBuildProjectDirectory)\models&quot;" />
  </Target>

</Project>
